# Aarogya Mitra — environment placeholders
# Copy this to .env.local and fill in real values only in your private environment.
# Never commit .env.local or real keys to Git.

# Supabase project URL (example: https://abc123.supabase.co)
VITE_SUPABASE_URL=

# Supabase public anon key (safe to expose in the browser, but still not a secret)
VITE_SUPABASE_ANON_KEY=

# Optional: email-reminders provider key (server-side only where supported)
# VITE_EMAIL_REMINDER_KEY=

# Optional: demo mode can run fully in the browser without Supabase.
# When Supabase is not configured, the app runs in demo mode with fictional data.
DEMO_MODE=true
